generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id @default(cuid())
  supabaseId  String?  @unique
  name        String
  email       String   @unique
  password    String?
  avatarUrl   String?
  role        UserRole @default(FARMER)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  farms             Farm[]
  expenses          Expense[]
  harvests          Harvest[]
  diagnoses         Diagnosis[]
  listings          MarketplaceListing[]
  demands           MarketDemand[]       @relation("BuyerDemands")
  activities        FarmActivity[]
  academyProgress   AcademyProgress[]
  practiceSessions  PracticeSession[]

  @@index([role])
}

model Farm {
  id        String   @id @default(cuid())
  userId    String
  name      String
  location  String?
  latitude  Float?
  longitude Float?
  area      Float?
  unit      String?  @default("m2")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  crops      Crop[]
  expenses   Expense[]
  harvests   Harvest[]
  activities FarmActivity[]

  @@index([userId, createdAt])
}

// Crop merupakan siklus budidaya pada schema awal.
model Crop {
  id               String     @id @default(cuid())
  farmId           String
  name             String
  variety          String?
  plantedAt        DateTime?
  expectedHarvest  DateTime?
  budgetAmount     Decimal?   @db.Decimal(14, 2)
  status           CropStatus @default(PLANTED)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @default(now()) @updatedAt

  farm       Farm           @relation(fields: [farmId], references: [id], onDelete: Cascade)
  expenses   Expense[]
  harvests   Harvest[]
  activities FarmActivity[]

  @@index([farmId, status])
  @@index([plantedAt])
}

model Expense {
  id        String   @id @default(cuid())
  userId    String
  farmId    String?
  cropId    String?
  category  String
  amount    Decimal  @db.Decimal(14, 2)
  note      String?
  date      DateTime @default(now())
  createdAt DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  farm Farm? @relation(fields: [farmId], references: [id], onDelete: SetNull)
  crop Crop? @relation(fields: [cropId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([farmId, date])
  @@index([cropId, date])
}

model Harvest {
  id          String      @id @default(cuid())
  userId      String
  farmId      String?
  cropId      String?
  cropName    String
  quantity    Float
  unit        String
  quality     QualityGrade?
  harvestDate DateTime
  createdAt   DateTime    @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  farm Farm? @relation(fields: [farmId], references: [id], onDelete: SetNull)
  crop Crop? @relation(fields: [cropId], references: [id], onDelete: SetNull)

  @@index([userId, harvestDate])
  @@index([farmId, harvestDate])
  @@index([cropId, harvestDate])
}

model Diagnosis {
  id         String   @id @default(cuid())
  userId     String
  crop       String
  imageUrl   String?
  result     String?
  confidence Float?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model MarketplaceListing {
  id          String        @id @default(cuid())
  userId      String
  title       String
  commodity   String
  quantity    Float
  unit        String
  price       Decimal?      @db.Decimal(14, 2)
  quality     QualityGrade?
  location    String?
  description String?
  status      ListingStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([commodity, status])
}

model MarketPrice {
  id         String   @id @default(cuid())
  commodity  String
  price      Decimal  @db.Decimal(14, 2)
  unit       String   @default("kg")
  location   String?
  source     String?
  isDemo     Boolean  @default(true)
  observedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([commodity, observedAt])
  @@index([location, observedAt])
}

model MarketDemand {
  id          String       @id @default(cuid())
  buyerId     String
  commodity   String
  minQuantity Float?
  maxQuantity Float?
  unit        String       @default("kg")
  quality     QualityGrade?
  maxPrice    Decimal?     @db.Decimal(14, 2)
  location    String?
  needBy      DateTime?
  status      DemandStatus @default(OPEN)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @default(now()) @updatedAt

  buyer User @relation("BuyerDemands", fields: [buyerId], references: [id], onDelete: Cascade)

  @@index([status, commodity])
  @@index([buyerId, status])
  @@index([needBy])
}

model FarmActivity {
  id          String   @id @default(cuid())
  userId      String
  farmId      String
  cropId      String?
  type        String
  title       String
  description String?
  observedAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)
  crop Crop? @relation(fields: [cropId], references: [id], onDelete: SetNull)

  @@index([userId, observedAt])
  @@index([farmId, observedAt])
  @@index([cropId, observedAt])
}

model AcademyProgress {
  id           String                @id @default(cuid())
  userId       String
  missionId    String
  title        String
  status       AcademyProgressStatus @default(IN_PROGRESS)
  bestScore    Int                   @default(0)
  xpAwarded    Int                   @default(0)
  attemptCount Int                   @default(0)
  completedAt  DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, missionId])
  @@index([userId, status])
}

model PracticeSession {
  id          String         @id @default(cuid())
  userId      String
  practiceId  String
  title       String
  status      PracticeStatus @default(STARTED)
  startedAt   DateTime       @default(now())
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, startedAt])
  @@index([userId, practiceId])
}

enum UserRole {
  FARMER
  BUYER
  ADMIN
}

enum CropStatus {
  PLANNED
  PLANTED
  GROWING
  HARVESTED
}

enum QualityGrade {
  A
  B
  C
}

enum ListingStatus {
  ACTIVE
  CLOSED
}

enum DemandStatus {
  OPEN
  MATCHED
  CLOSED
  CANCELLED
}

enum AcademyProgressStatus {
  IN_PROGRESS
  COMPLETED
}

enum PracticeStatus {
  STARTED
  COMPLETED
  CANCELLED
}
