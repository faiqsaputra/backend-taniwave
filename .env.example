# Express
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Supabase Auth. Use the project's public/anon key; never put service_role here.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# Prisma runtime connection (prefer the Supabase pooler URL for hosted/serverless apps).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require

# Optional direct connection URL for Prisma migrations. If omitted, DATABASE_URL is used.
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# Optional request timeout for public weather API
WEATHER_TIMEOUT_MS=5000
